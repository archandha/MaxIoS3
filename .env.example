# S3 Server Configuration

# Metadata backend — SQLite (default, zero-dependency) or PostgreSQL (production).
# The backend is selected automatically from the URL scheme.
#
# SQLite:
DATABASE_URL=sqlite:metadata.db
#
# PostgreSQL:
# DATABASE_URL=postgres://maxios3:secret@localhost/maxios3db

# Root directory for object storage
STORAGE_ROOT=./data

# Server bind address
HOST=0.0.0.0

# Server port
PORT=3000

# Logging level (error, warn, info, debug, trace)
LOG_LEVEL=info

# Optional TLS configuration (HTTPS)
# TLS_CERT=cert.pem
# TLS_KEY=key.pem
